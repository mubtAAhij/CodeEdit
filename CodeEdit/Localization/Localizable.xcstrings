      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeEdit makes use of the Mason Registry for language server installation. To install a package, CodeEdit uses the package manager directed by the Mason Registry, and installs a copy of the language server in Application Support.\n\nLanguage server installation is still experimental, there may be bugs and expect this flow to change over time."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "CodeEdit utiliza el Mason Registry para la instalación de servidores de lenguaje. Para instalar un paquete, CodeEdit usa el gestor de paquetes indicado por el Mason Registry e instala una copia del servidor de lenguaje en Soporte de Aplicaciones.\n\nLa instalación de servidores de lenguaje aún es experimental, puede haber errores y este flujo puede cambiar con el tiempo."
          }
        }
      }
    },
