    "lsp.registry.npm.install-confirmation.message": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This requires %#@package_count@.\nAllow CodeEdit to install %#@target_count@?"
          },
          "substitutions": {
            "package_count": {
              "argNum": 1,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "the npm package %1$@"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "the npm packages %1$@"
                    }
                  }
                }
              }
            },
            "target_count": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "this package"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "these packages"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
