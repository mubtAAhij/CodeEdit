        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This requires %#@package_noun@ %@.\nAllow CodeEdit to install ?"
          },
          "substitutions": {
            "package_noun": {
              "argNum": 1,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "this package"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "these packages"
                    }
                  }
                }
              }
            },
            "suffix_noun": {
              "argNum": 2,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
