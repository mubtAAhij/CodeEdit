            "state": "translated",
            "value": "This requires %#@package_noun@ %@.\nAllow CodeEdit to install %#@suffix_noun@?"
          },
          "substitutions": {
            "package_noun": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "this package"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "these packages"
                    }
